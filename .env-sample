# =====================================================
# SteadyPhoto Environment Configuration
# WARNING: Do NOT commit this file to version control!
# Add it to your .gitignore if you haven't already.
# =====================================================

# --- PostgreSQL Database ---
POSTGRES_USER=steadyphoto
POSTGRES_PASSWORD=123
POSTGRES_DB=steadyphoto

# --- API / Application ---
API_PORT=8081
API_BASE_URL=http://localhost:${API_PORT}
STORAGE_DIR=storage

# --- Initial Admin User (created on first run via migration) ---
ADMIN_EMAIL=admin@steadyphoto.com
ADMIN_PASSWORD=123 

DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable"
LOG_LEVEL=debug
