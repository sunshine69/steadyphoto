package api

// SharedMediaResponse includes path info so the frontend can generate thumbnails/serve files
import (
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"os"
	"path/filepath"
	"strconv"
	"strings"
	"time"

	"steadyphoto/internal/domain"

	"github.com/go-chi/chi/v5"
	"github.com/google/uuid"
)

type SharedMediaFullResponse struct {
	ID           uuid.UUID `json:"id"`
	UserID       uuid.UUID `json:"userId"`
	Filename     string    `json:"filename"`
	Path         string    `json:"path"`
	MediaType    string    `json:"mediaType"`
	CapturedAt   time.Time `json:"capturedAt"`
	SharerUserID uuid.UUID `json:"sharerUserId"`
}

type SharedAlbumFullResponse struct {
	ID           uuid.UUID  `json:"id"`
	Name         string     `json:"name"`
	Description  *string    `json:"description,omitempty"`
	UserID       uuid.UUID  `json:"userId"`
	CreatedAt    time.Time  `json:"createdAt"`
	SharerUserID uuid.UUID  `json:"sharerUserId"`
}

type SharedAlbumMediaResponse struct {
	Items  []SharedAlbumMediaItem `json:"items"`
	Total  int                    `json:"total"`
	Limit  int                    `json:"limit"`
	Offset int                    `json:"offset"`
}

type SharedAlbumMediaItem struct {
	ID         uuid.UUID `json:"id"`
	Filename   string    `json:"filename"`
	Path       string    `json:"path"`
	MediaType  string    `json:"mediaType"`
	CapturedAt time.Time `json:"capturedAt"`
}

// logRequest logs a request with its path and user agent, returning the current time for duration tracking.
func logRequest(r *http.Request, label string) time.Time {
	start := time.Now()
	log.Printf("[INFO] [%s] %s %s from %s", label, r.Method, r.URL.Path, r.RemoteAddr)
	return start
}

// handleGetSharedMedia returns metadata for a single media item shared with the current user.
func (s *Server) handleGetSharedMedia(w http.ResponseWriter, r *http.Request) {
	start := logRequest(r, "handleGetSharedMedia")

	ctx := r.Context()
	idStr := chi.URLParam(r, "id")

	userID, ok := GetUserIDFromContext(ctx)
	if !ok {
		log.Printf("[WARN] [%s] Unauthorized request - no user in context. IP: %s", "handleGetSharedMedia", r.RemoteAddr)
		http.Error(w, "Unauthorized", http.StatusUnauthorized)
		return
	}

	id, err := uuid.Parse(idStr)
	if err != nil {
		log.Printf("[ERROR] [%s] parse UUID (%s): %v — took %v", "handleGetSharedMedia", idStr, err, time.Since(start))
		http.Error(w, "Invalid UUID format", http.StatusBadRequest)
		return
	}

	item, err := s.mediaShareRepo.GetSharedMediaByID(ctx, id, userID)
	if err != nil {
		log.Printf("[ERROR] [%s] GetSharedMediaByID (%s): %v — took %v", "handleGetSharedMedia", id, err, time.Since(start))
		http.Error(w, "Shared media not found or access denied", http.StatusNotFound)
		return
	}

	log.Printf("[INFO] [%s] Found shared media: ID=%s, filename=%s, userID=%s — took %v", "handleGetSharedMedia", idStr, item.Media.Filename, item.Media.UserID, time.Since(start))

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(SharedMediaFullResponse{
		ID:           item.Media.ID,
		UserID:       item.Media.UserID,
		Filename:     item.Media.Filename,
		Path:         item.Media.Path,
		MediaType:    string(item.Media.MediaType),
		CapturedAt:   item.Media.CapturedAt,
		SharerUserID: item.SharerUserID,
	})
}

// handleGetSharedMediaOriginal streams the actual file for a shared media item.
func (s *Server) handleGetSharedMediaOriginal(w http.ResponseWriter, r *http.Request) {
	start := logRequest(r, "handleGetSharedMediaOriginal")

	ctx := r.Context()
	idStr := chi.URLParam(r, "id")

	userID, ok := GetUserIDFromContext(ctx)
	if !ok {
		log.Printf("[WARN] [%s] Unauthorized request - no user in context. IP: %s", "handleGetSharedMediaOriginal", r.RemoteAddr)
		http.Error(w, "Unauthorized", http.StatusUnauthorized)
		return
	}

	id, err := uuid.Parse(idStr)
	if err != nil {
		log.Printf("[ERROR] [%s] parse UUID (%s): %v — took %v", "handleGetSharedMediaOriginal", idStr, err, time.Since(start))
		http.Error(w, "Invalid UUID format", http.StatusBadRequest)
		return
	}

	item, err := s.mediaShareRepo.GetSharedMediaByID(ctx, id, userID)
	if err != nil {
		log.Printf("[ERROR] [%s] GetSharedMediaByID (%s): %v — took %v", "handleGetSharedMediaOriginal", id, err, time.Since(start))
		http.Error(w, "Shared media not found or access denied", http.StatusNotFound)
		return
	}

	targetPath := item.Media.Path
	absPath, err := s.storageService.ResolvePath(targetPath)
	if err != nil {
		targetPath = strings.TrimLeft(targetPath, "/\\")
		absPath, err = s.storageService.ResolvePath(targetPath)
	}

	if err != nil {
		log.Printf("[ERROR] [%s] resolvePath (%s): %v — took %v", "handleGetSharedMediaOriginal", targetPath, err, time.Since(start))
		http.Error(w, "Could not locate file: "+err.Error(), http.StatusInternalServerError)
		return
	}

	contentType := s.getContentType(item.Media.MediaType, item.Media.Filename)
	w.Header().Set("Content-Type", contentType)
	w.Header().Set("Accept-Ranges", "bytes")
	w.Header().Set("Access-Control-Expose-Headers", "Content-Length, Content-Type, Accept-Ranges, Content-Range")

	log.Printf("[INFO] [%s] Serving original file: ID=%s, path=%s — took %v", "handleGetSharedMediaOriginal", idStr, absPath, time.Since(start))
	http.ServeFile(w, r, absPath)
}

// handleGetSharedMediaThumb streams the thumbnail for a shared media item.
func (s *Server) handleGetSharedMediaThumb(w http.ResponseWriter, r *http.Request) {
	start := logRequest(r, "handleGetSharedMediaThumb")

	ctx := r.Context()
	idStr := chi.URLParam(r, "id")

	userID, ok := GetUserIDFromContext(ctx)
	if !ok {
		log.Printf("[WARN] [%s] Unauthorized request - no user in context. IP: %s", "handleGetSharedMediaThumb", r.RemoteAddr)
		http.Error(w, "Unauthorized", http.StatusUnauthorized)
		return
	}

	id, err := uuid.Parse(idStr)
	if err != nil {
		log.Printf("[ERROR] [%s] parse UUID (%s): %v — took %v", "handleGetSharedMediaThumb", idStr, err, time.Since(start))
		http.Error(w, "Invalid UUID format", http.StatusBadRequest)
		return
	}

	item, err := s.mediaShareRepo.GetSharedMediaByID(ctx, id, userID)
	if err != nil {
		log.Printf("[ERROR] [%s] GetSharedMediaByID (%s): %v — took %v", "handleGetSharedMediaThumb", id, err, time.Since(start))
		http.Error(w, "Shared media not found or access denied", http.StatusNotFound)
		return
	}

	relPath := filepath.Clean(item.Media.Path)
	ext := filepath.Ext(relPath)

	var thumbRelPath string
	if item.Media.MediaType == domain.MediaTypeVideo {
		cleanPath := strings.TrimPrefix(item.Media.Path, "storage/")
		basePart := strings.TrimSuffix(cleanPath, ext)
		basePart = strings.Replace(basePart, "/.videos/", "/", 1)
		thumbRelPath = basePart + ".webp"
	} else {
		cleanPath := strings.TrimPrefix(item.Media.Path, "storage/")
		basePart := strings.TrimSuffix(cleanPath, ext)
		thumbRelPath = basePart + "_thumb.webp"
	}

	fullThumbPath := filepath.Join(s.thumbRoot, ".thumbnails", thumbRelPath)

	if _, err := os.Stat(fullThumbPath); os.IsNotExist(err) {
		log.Printf("[WARN] [%s] Thumbnail NOT FOUND at %s. Attempting fallback to original. — took %v", "handleGetSharedMediaThumb", fullThumbPath, time.Since(start))
		targetPath := item.Media.Path
		absPath, resolveErr := s.storageService.ResolvePath(targetPath)
		if resolveErr != nil {
			targetPath = strings.TrimLeft(targetPath, "/\\")
			absPath, resolveErr = s.storageService.ResolvePath(targetPath)
		}

		if resolveErr != nil {
			log.Printf("[ERROR] [%s] fallback failed for (%s): %v — took %v", "handleGetSharedMediaThumb", targetPath, resolveErr, time.Since(start))
			http.Error(w, "Thumbnail not found and fallback failed", http.StatusNotFound)
			return
		}

		contentType := s.getContentType(item.Media.MediaType, item.Media.Filename)
		w.Header().Set("Content-Type", contentType)
		log.Printf("[INFO] [%s] Serving original file as fallback from %s — took %v", "handleGetSharedMediaThumb", absPath, time.Since(start))
		http.ServeFile(w, r, absPath)
		return
	}

	log.Printf("[INFO] [%s] Serving thumbnail: ID=%s, path=%s — took %v", "handleGetSharedMediaThumb", idStr, fullThumbPath, time.Since(start))
	http.ServeFile(w, r, fullThumbPath)
}

// handleGetSharedAlbum returns metadata for a single album shared with the current user.
func (s *Server) handleGetSharedAlbum(w http.ResponseWriter, r *http.Request) {
	start := logRequest(r, "handleGetSharedAlbum")

	ctx := r.Context()
	idStr := chi.URLParam(r, "id")

	userID, ok := GetUserIDFromContext(ctx)
	if !ok {
		log.Printf("[WARN] [%s] Unauthorized request - no user in context. IP: %s", "handleGetSharedAlbum", r.RemoteAddr)
		http.Error(w, "Unauthorized", http.StatusUnauthorized)
		return
	}

	id, err := uuid.Parse(idStr)
	if err != nil {
		log.Printf("[ERROR] [%s] parse UUID (%s): %v — took %v", "handleGetSharedAlbum", idStr, err, time.Since(start))
		http.Error(w, "Invalid UUID format", http.StatusBadRequest)
		return
	}

	item, err := s.mediaShareRepo.GetSharedAlbumByID(ctx, id, userID)
	if err != nil {
		log.Printf("[ERROR] [%s] GetSharedAlbumByID (%s): %v — took %v", "handleGetSharedAlbum", id, err, time.Since(start))
		http.Error(w, "Shared album not found or access denied", http.StatusNotFound)
		return
	}

	log.Printf("[INFO] [%s] Found shared album: ID=%s, name=%s — took %v", "handleGetSharedAlbum", idStr, item.Album.Name, time.Since(start))

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(SharedAlbumFullResponse{
		ID:           item.Album.ID,
		Name:         item.Album.Name,
		Description:  item.Album.Description,
		UserID:       item.Album.UserID,
		CreatedAt:    item.Album.CreatedAt,
		SharerUserID: item.SharerUserID,
	})
}

// handleListSharedAlbumMedia returns media items in a shared album.
func (s *Server) handleListSharedAlbumMedia(w http.ResponseWriter, r *http.Request) {
	start := logRequest(r, "handleListSharedAlbumMedia")

	ctx := r.Context()
	idStr := chi.URLParam(r, "id")

	userID, ok := GetUserIDFromContext(ctx)
	if !ok {
		log.Printf("[WARN] [%s] Unauthorized request - no user in context. IP: %s", "handleListSharedAlbumMedia", r.RemoteAddr)
		http.Error(w, "Unauthorized", http.StatusUnauthorized)
		return
	}

	id, err := uuid.Parse(idStr)
	if err != nil {
		log.Printf("[ERROR] [%s] parse UUID (%s): %v — took %v", "handleListSharedAlbumMedia", idStr, err, time.Since(start))
		http.Error(w, "Invalid UUID format", http.StatusBadRequest)
		return
	}

	limit := 50
	offset := 0
	if lStr := r.URL.Query().Get("limit"); lStr != "" {
		if l, e := strconv.Atoi(lStr); e == nil && l > 0 {
			limit = l
		}
	}
	if oStr := r.URL.Query().Get("offset"); oStr != "" {
		if o, e := strconv.Atoi(oStr); e == nil && o >= 0 {
			offset = o
		}
	}

	log.Printf("[INFO] [%s] Query params: limit=%d, offset=%d — took %v", "handleListSharedAlbumMedia", limit, offset, time.Since(start))

	items, totalItems, err := s.mediaShareRepo.ListMediaInSharedAlbum(ctx, id, userID, limit, offset)
	if err != nil {
		log.Printf("[ERROR] [%s] ListMediaInSharedAlbum (%s): %v — took %v", "handleListSharedAlbumMedia", id, err, time.Since(start))
		http.Error(w, "Failed to list shared album media: "+err.Error(), http.StatusInternalServerError)
		return
	}

	log.Printf("[INFO] [%s] Found %d items (total=%d) — took %v", "handleListSharedAlbumMedia", len(items), totalItems, time.Since(start))

	respItems := make([]SharedAlbumMediaItem, 0, len(items))
	for _, item := range items {
		respItems = append(respItems, SharedAlbumMediaItem{
			ID:         item.Media.ID,
			Filename:   item.Media.Filename,
			Path:       item.Media.Path,
			MediaType:  string(item.Media.MediaType),
			CapturedAt: item.Media.CapturedAt,
		})
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(SharedAlbumMediaResponse{
		Items:  respItems,
		Total:  totalItems,
		Limit:  limit,
		Offset: offset,
	})
}
