<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for media scanning and upload -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Storage permissions (Android 13+ uses granular permissions) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    
    <!-- Foreground service for background scanning/uploading -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <!-- Wake lock to prevent sleep during uploads -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Boot completed to start SyncService on device startup -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".SteadyPhotoApplication"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SteadyPhotoSync"
        tools:targetApi="34">

        <!-- Main Activity (Settings & Status Screen) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SteadyPhotoSync">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Service for background sync -->
        <service
            android:name=".worker.SyncService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- BroadcastReceiver to detect media scanner events (USB/MTP downloads, etc.) -->
        <receiver
            android:name=".worker.MediaChangeReceiver"
            android:exported="true">
            <intent-filter>
                <!-- Fires when system starts scanning for new media files -->
                <action android:name="android.intent.action.MEDIA_SCANNER_STARTED" />
                <!-- Fires when system finishes scanning - this is the key event! -->
                <action android:name="android.intent.action.MEDIA_SCANNER_FINISHED" />
            </intent-filter>
            <intent-filter>
                <!-- Also listen for external storage events (USB mount/unmount) -->
                <action android:name="android.intent.action.ACTION_EXTERNAL_APPLICATIONS_AVAILABLE" />
                <action android:name="android.intent.action.ACTION_EXTERNAL_APPLICATIONS_UNAVAILABLE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
