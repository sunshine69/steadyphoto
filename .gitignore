# Kotlin
kotlin/
*.kt_class

# Android Resource Cache
res/drawable-nodpi/
res/layout-large/
res/layout-xlarge/

# Build output directories for this project
app/build/
app/.cxx/
gomobile-bindings/build/

# ============================================
# Gomobile Bindings - Generated Android Artifacts
# ============================================

# gomobile build output (the AAR with Go bindings)
# NOTE: mobile-bindings.aar is committed as a local dependency for Gradle.
# If you prefer contributors to rebuild it themselves, remove the line below.
!android/app/libs/mobile-bindings.aar

# Native libraries generated by gomobile bind (if not already covered above)
**/jniLibs/**/*.so

# Other AAR files that might be generated or downloaded
android/gomobile-bindings/*.aar

