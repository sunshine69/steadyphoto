# ============================================
# General Patterns
# ============================================

# Build artifacts and outputs
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/

# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*

# ============================================
# Android / Kotlin Project Specific Patterns
# ============================================

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/

# Android Studio
.idea/
*.iml
*.iws
*.ipr
.android/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex

# Local configuration file (sdk path, etc)
local.properties

# ProGuard folder generated by Eclipse
proguard/

# Keystore files - used for signing your app
*.jks
*.keystore
*.p12
*.pfx
*.jceks
debug.keystore

# Android Phone/Tab screenshots 
*.png
*.jpg
*.jpeg

# Android Web Assets
assets/web/

# Native library files generated by Android Studio NDK build
**/*.so

# Kotlin
kotlin/
*.kt_class

# Android Resource Cache
res/drawable-nodpi/
res/layout-large/
res/layout-xlarge/

# Build output directories for this project
app/build/
app/.cxx/
gomobile-bindings/build/

# ============================================
# Go Project Patterns (Backend)
# ============================================

# Go build artifacts
*.exe
server
worker
scanner
main

# Go test coverage
coverage/
*.lcov

# Test reports
reports/
test-results/

# ============================================
# Node.js / Angular Patterns
# ============================================

angular-app/dist/**
**/node_modules/**

# ============================================
# Playwright / Testing
# ============================================
.playwright-mcp/**

# ============================================
# Storage and Data Files
# ============================================
storage/*
**/cache/**
*.db
*.sqlite3

# ============================================
# Backup and Temporary Files
# ============================================
*.bak
*.tmp
*.temp
*.swp
*.swo
*.*~
*~
*.list

# ============================================
# OS Generated Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# IDE and Editor Files
# ============================================
.vscode/
*.swp
*.~
nohup.out 
