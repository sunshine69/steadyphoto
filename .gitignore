# ====================================================================
# GOLANG CONFIGURATION
# ====================================================================

# Compiled binaries and execution files
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof

# Common Go build outputs (if you build to a target bin folder)
bin/
pkg/

# Main project binaries (adjust if your output file has a specific name)
dist/
/vendor/

# Go toolchain and workspace files
go.work
go.work.sum

# ====================================================================
# KOTLIN ANDROID CONFIGURATION
# ====================================================================

# Android Studio / IntelliJ IDEA files
.idea/
*.iml
.gradle/
build/
captures/

# Local configuration files (contains your local SDK paths, passwords, etc.)
local.properties
.egl/
.externalNativeBuild/
.cxx/

# Keystore files (NEVER commit your signing keys)
*.jks
*.keystore
*.p12

# Google Play Services configuration file
google-services.json

# Android App Bundle outputs
*.aab
*.apk

# Device crash reports and lint reports
*-crash.txt
lint/reports/

